# Cache overrides may select this checkout's disposable outputs or the declared
# global cpkt cache, never another checkout's generated tool/dependency state.
function(lql_real_cache_path path out)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "Cache paths must be absolute: ${path}")
  endif()
  set(parent "${path}")
  set(suffix "")
  while(NOT EXISTS "${parent}")
    if(IS_SYMLINK "${parent}")
      message(FATAL_ERROR "Cache path contains a dangling symlink: ${path}")
    endif()
    get_filename_component(name "${parent}" NAME)
    get_filename_component(parent "${parent}" DIRECTORY)
    list(PREPEND suffix "${name}")
  endwhile()
  file(REAL_PATH "${parent}" resolved)
  if(suffix)
    cmake_path(APPEND resolved ${suffix})
    cmake_path(NORMAL_PATH resolved)
  endif()
  set(${out} "${resolved}" PARENT_SCOPE)
endfunction()

function(lql_check_cache_path path kind)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "${kind} cache requires an absolute path: ${path}")
  endif()
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  set(allowed "${root}/build" "${root}/.cache")
  if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    list(APPEND allowed "$ENV{XDG_CACHE_HOME}/cpkt/${kind}")
  elseif(DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
    list(APPEND allowed "$ENV{HOME}/.cache/cpkt/${kind}")
  endif()
  lql_real_cache_path("${path}" actual)
  foreach(candidate IN LISTS allowed)
    # Keep owned roots literal: resolving a symlinked build/ or .cache/ here
    # would authorize another checkout's outputs as our own.
    string(FIND "${actual}/" "${candidate}/" within)
    if(within EQUAL 0)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "${kind} cache must be in this checkout's build/ or .cache/, or its declared global cpkt cache: ${path}")
endfunction()
if(DEFINED LQL_CACHE_PATH AND DEFINED LQL_CACHE_KIND)
  lql_check_cache_path("${LQL_CACHE_PATH}" "${LQL_CACHE_KIND}")
endif()
