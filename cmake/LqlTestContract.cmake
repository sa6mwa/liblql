function(lql_verify_test_contract)
  get_property(tests DIRECTORY PROPERTY TESTS)
  if(NOT tests)
    message(FATAL_ERROR "CTest contract: no tests registered")
  endif()
  set(allowed_labels unit smoke local packaging fuzz integration example-smoke offline)
  foreach(test IN LISTS tests)
    get_test_property(${test} TIMEOUT timeout)
    get_test_property(${test} LABELS labels)
    if(NOT timeout GREATER 0 OR timeout GREATER 60 OR NOT "local" IN_LIST labels)
      message(FATAL_ERROR "${test}: missing local label or timeout outside 1..60 seconds")
    endif()
    foreach(label IN LISTS labels)
      if(NOT label IN_LIST allowed_labels)
        message(FATAL_ERROR "${test}: unknown test label: ${label}")
      endif()
    endforeach()
  endforeach()
endfunction()
