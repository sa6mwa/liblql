prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: liblql
Description: C89 Lockd Query Language library
Version: @PROJECT_VERSION@
Requires.private: lonejson
Libs: -L${libdir} -llql
Cflags: -I${includedir}
