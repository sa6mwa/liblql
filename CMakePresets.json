{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LQL_DEPENDENCY_MODE": "bundled"
      }
    },
    {"name": "debug", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "LQL_TARGET_ID": "x86_64-linux-gnu"}},
    {"name": "asan", "inherits": "debug", "cacheVariables": {"CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"}},
    {"name": "x86_64-linux-gnu-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "x86_64-linux-gnu", "LQL_TARGET_ARCH": "x86_64", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "gnu"}},
    {"name": "x86_64-linux-musl-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "x86_64-linux-musl", "LQL_TARGET_ARCH": "x86_64", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "musl"}},
    {"name": "aarch64-linux-gnu-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "aarch64-linux-gnu", "LQL_TARGET_ARCH": "aarch64", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "gnu"}},
    {"name": "aarch64-linux-musl-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "aarch64-linux-musl", "LQL_TARGET_ARCH": "aarch64", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "musl"}},
    {"name": "armhf-linux-gnu-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "armhf-linux-gnu", "LQL_TARGET_ARCH": "armhf", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "gnu"}},
    {"name": "armhf-linux-musl-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "armhf-linux-musl", "LQL_TARGET_ARCH": "armhf", "LQL_TARGET_OS": "linux", "LQL_TARGET_LIBC": "musl"}},
    {"name": "arm64-apple-darwin-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "LQL_TARGET_ID": "arm64-apple-darwin", "LQL_TARGET_ARCH": "arm64", "LQL_TARGET_OS": "darwin", "LQL_TARGET_LIBC": ""}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release"},
    {"name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release"},
    {"name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release"},
    {"name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release"},
    {"name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release"},
    {"name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release"},
    {"name": "arm64-apple-darwin-release", "configurePreset": "arm64-apple-darwin-release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}
  ]
}
