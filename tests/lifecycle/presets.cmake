cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${root}/CMakePresets.json" presets)
foreach(kind configure build test)
  string(JSON count LENGTH "${presets}" "${kind}Presets")
  math(EXPR last "${count} - 1")
  set(names "")
  foreach(index RANGE ${last})
    string(JSON name GET "${presets}" "${kind}Presets" ${index} name)
    list(APPEND names "${name}")
    if(kind STREQUAL "configure")
      set(configure_${name} ${index})
    endif()
  endforeach()
  set(required debug debug-lua release valgrind fuzz musl-debug musl-release
    x86_64-linux-gnu-release x86_64-linux-musl-release
    aarch64-linux-gnu-release aarch64-linux-musl-release
    armhf-linux-gnu-release armhf-linux-musl-release arm64-apple-darwin-release)
  if(kind STREQUAL "configure")
    list(APPEND required base)
  elseif(kind STREQUAL "test")
    set(required debug debug-lua valgrind musl-debug musl-release)
  endif()
  foreach(name IN LISTS required)
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "Missing ${kind} preset: ${name}")
    endif()
  endforeach()
endforeach()
function(require_variable preset variable expected)
  string(JSON actual GET "${presets}" configurePresets ${configure_${preset}}
    cacheVariables "${variable}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${preset}: ${variable} is ${actual}, expected ${expected}")
  endif()
endfunction()
require_variable(base CMAKE_TOOLCHAIN_FILE "\${sourceDir}/cmake/cpkt-toolchain.cmake")
require_variable(base CMAKE_EXPORT_COMPILE_COMMANDS ON)
require_variable(base LQL_TARGET_ID x86_64-linux-gnu)
require_variable(fuzz CMAKE_TOOLCHAIN_FILE "\${sourceDir}/cmake/cpkt-aflpp-toolchain.cmake")
require_variable(fuzz LQL_BUILD_FUZZERS ON)
require_variable(debug-lua LQL_BUILD_LUA ON)
foreach(preset musl-debug musl-release)
  require_variable(${preset} LQL_TARGET_ID x86_64-linux-musl)
  require_variable(${preset} BUILD_TESTING ON)
endforeach()
foreach(target x86_64-linux-gnu x86_64-linux-musl aarch64-linux-gnu aarch64-linux-musl
    armhf-linux-gnu armhf-linux-musl arm64-apple-darwin)
  require_variable(${target}-release LQL_TARGET_ID ${target})
  require_variable(${target}-release LQL_DIST_DIR "\${sourceDir}/dist")
endforeach()
require_variable(arm64-apple-darwin-release LQL_BUILD_DIRECT_PROBE OFF)
foreach(variable BUILD_TESTING LQL_BUILD_STATIC LQL_BUILD_SHARED
    LQL_BUILD_BINARY LQL_CLQL_STATIC)
  require_variable(arm64-apple-darwin-release ${variable} ON)
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --list-presets=all
  WORKING_DIRECTORY "${root}" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CMake rejected lifecycle presets")
endif()
message(STATUS "Lifecycle preset contract passed")
