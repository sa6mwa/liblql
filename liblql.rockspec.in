package = "liblql"
version = "@VERSION@-1"

source = {
   url = "@LUA_SOURCE_URL@",
   dir = "liblql-lua-@VERSION@"
}

description = {
   summary = "Lua facade for liblql",
   detailed = [[
      liblql is a C89 port of pkt.systems/lql. This Lua package exposes a
      direct Lua 5.5 C module over the public liblql SDK.
   ]],
   homepage = "https://github.com/sa6mwa/liblql",
   license = "MIT"
}

dependencies = {
   "lua >= 5.5, < 5.6"
}

external_dependencies = {
   LIBLQL = {
      header = "lql/lql.h",
      library = "lql"
   }
}

build = {
   type = "builtin",
   modules = {
      lql = "lua/lql.lua",
      ["lql.core"] = {
         sources = { "lua/lql_core.c" },
         incdirs = { "$(LIBLQL_INCDIR)" },
         libdirs = { "$(LIBLQL_LIBDIR)" },
         libraries = { "lql" }
      }
   }
}
